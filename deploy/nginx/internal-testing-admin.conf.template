# Internal-testing ADMIN Nginx template. Render only with the dedicated wrapper after hostname
# validation. Keep this container and its listener reachable only through the approved WireGuard
# address and host firewall.
server_tokens off;

upstream eltnoy_internal_testing_admin_listener {
    server it-api-admin:4001;
}

map $http_host $eltnoy_internal_testing_original_host {
    default "";
    "~*^@@INTERNAL_TEST_ADMIN_REGEX@@$" "@@INTERNAL_TEST_ADMIN_HOSTNAME@@";
}

server {
    listen 8080 default_server;
    server_name _;
    location = /_internal-health {
        access_log off;
        allow 127.0.0.1;
        deny all;
        default_type text/plain;
        return 200 "ok\n";
    }
    location / { return 444; }
}

server {
    listen 8080;
    server_name @@INTERNAL_TEST_ADMIN_HOSTNAME@@;
    if ($eltnoy_internal_testing_original_host != "@@INTERNAL_TEST_ADMIN_HOSTNAME@@") { return 421; }
    location / { return 301 https://@@INTERNAL_TEST_ADMIN_HOSTNAME@@$request_uri; }
}

server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 8443 ssl;
    server_name @@INTERNAL_TEST_ADMIN_HOSTNAME@@;
    include /etc/nginx/includes/eltnoy-tls.conf;
    if ($eltnoy_internal_testing_original_host != "@@INTERNAL_TEST_ADMIN_HOSTNAME@@") { return 421; }
    location / {
        include /etc/nginx/includes/eltnoy-proxy.conf;
        proxy_pass http://eltnoy_internal_testing_admin_listener;
    }
}
