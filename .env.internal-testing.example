# Copy to an operator-controlled path OUTSIDE the repository as .env.internal-testing.
# Use fresh testing-only values. Never copy .env.production or production secret/certificate paths.
# The internal-testing wrapper requires every value below and rejects unknown/non-testing keys.

INTERNAL_TEST_DATABASE_NAME=
INTERNAL_TEST_POSTGRES_USER=
INTERNAL_TEST_ROLE_BOOTSTRAP_APPROVAL=PENDING
INTERNAL_TEST_ROLE_PASSWORDS_CONFIGURED=NO
INTERNAL_TEST_ROOT_DIR=
INTERNAL_TEST_SECRETS_DIR=
INTERNAL_TEST_POSTGRES_TLS_DIR=
INTERNAL_TEST_POSTGRES_CA_FILE=
INTERNAL_TEST_PUBLIC_TLS_CERT_DIR=
INTERNAL_TEST_ADMIN_TLS_CERT_DIR=
INTERNAL_TEST_NGINX_RENDERED_DIR=
INTERNAL_TEST_API_IMAGE=
INTERNAL_TEST_NGINX_IMAGE=
INTERNAL_TEST_POSTGRES_IMAGE=

# Choose four approved, distinct, non-production internal DNS names. Do not use ELTNOY production
# domains, public DNS, guessed names, or a hostname not covered by the testing certificates.
INTERNAL_TEST_MARKETING_HOSTNAME=
INTERNAL_TEST_EXAM_HOSTNAME=
INTERNAL_TEST_INSTITUTION_HOSTNAME=
INTERNAL_TEST_ADMIN_HOSTNAME=

# Host addresses and Docker-only subnets must be selected by the network operator. Admin bind must
# equal the actual WireGuard interface address. The public bind must be private RFC1918.
INTERNAL_TEST_PUBLIC_BIND_ADDRESS=
INTERNAL_TEST_ADMIN_BIND_ADDRESS=
INTERNAL_TEST_WIREGUARD_INTERFACE_ADDRESS=
INTERNAL_TEST_PUBLIC_APP_SUBNET=
INTERNAL_TEST_ADMIN_APP_SUBNET=
INTERNAL_TEST_NGINX_PUBLIC_APP_ADDRESS=
INTERNAL_TEST_NGINX_ADMIN_APP_ADDRESS=
INTERNAL_TEST_API_PUBLIC_APP_ADDRESS=
INTERNAL_TEST_API_ADMIN_APP_ADDRESS=

# Keep these closed. A future migration invocation requires separate recorded approvals plus actual
# independent-review and PostgreSQL 17 runtime evidence; changing these values alone is not approval.
INTERNAL_TEST_MIGRATION_APPROVAL=PENDING
INTERNAL_TEST_PHASE2B_SOURCE_REVIEW=PENDING
INTERNAL_TEST_PHASE2B_POSTGRES17_RUNTIME=PENDING
INTERNAL_TEST_SCHEMA_MIGRATIONS=PENDING

# Required files under INTERNAL_TEST_SECRETS_DIR (single-line passwords, never stored here):
# postgres_superuser_password, eltnoy_app_password, eltnoy_migrator_password.
# Required TLS files: PostgreSQL server.crt/server.key and CA; each Nginx dir has
# fullchain.pem/privkey.pem. Use only internal-testing certificates.
