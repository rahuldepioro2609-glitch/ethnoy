# Copy to .env and set values for your self-managed installation.
DEPLOYMENT_MODE="development"
DATABASE_URL="postgresql://elt_app:replace-me@127.0.0.1:5432/eltnoy"
# Compose requires exactly true or false; true enables verified PostgreSQL TLS.
DATABASE_SSL=""
DATABASE_SSL_REJECT_UNAUTHORIZED="true"
DATABASE_POOL_SIZE="10"

# Docker Compose PostgreSQL credentials. Set a URL-safe random password in
# .env.production; Compose connects the app to the postgres service internally.
POSTGRES_DB="eltnoy"
POSTGRES_USER="eltnoy"
POSTGRES_PASSWORD=""
POSTGRES_TLS_DIR="/etc/eltnoy/postgres-tls"
POSTGRES_CA_FILE="/etc/eltnoy/postgres-tls/ca.crt"

PORT="4000"
NODE_ENV="development"
APP_ORIGIN="http://localhost:3000"
APP_HOSTNAME=""
TLS_CERT_DIR="/etc/eltnoy/tls"

# Institution document uploads remain hard-disabled in Milestone 2, even if
# these file policies are configured. Supported detected content types are
# PDF, JPEG, and PNG; browser MIME values are not trusted.
INSTITUTION_SUBMISSION_CAPABILITY_TTL_SECONDS="1800"
INSTITUTION_DOCUMENT_STORAGE_DIR=""
INSTITUTION_DOCUMENT_MAX_BYTES=""
INSTITUTION_DOCUMENT_ALLOWED_MIME_TYPES=""
INSTITUTION_DOCUMENT_CARDINALITY=""
INSTITUTION_DOCUMENT_MAX_DOCUMENTS_PER_CATEGORY=""
# Replacement is disabled unless explicitly enabled after the client confirms rules.
INSTITUTION_DOCUMENT_REPLACEMENT_ENABLED="false"
INSTITUTION_DOCUMENT_MAX_VERSIONS_PER_DOCUMENT=""
# Do not set decision codes until the client confirms decision vocabulary and rules.
INSTITUTION_DOCUMENT_REVIEW_DECISION_CODES=""
