# Copy to .env and set values for your self-managed installation.
DEPLOYMENT_MODE="development"
# Running the API directly (npm run dev:api): a URL with a password still works for local development.
# Alternatively leave the password out of the URL and set DATABASE_PASSWORD_FILE to an absolute path of a
# file holding only the password (mode 0400/0440, never world-readable). Never set both.
DATABASE_URL="postgresql://elt_app:replace-me@127.0.0.1:5432/eltnoy"
DATABASE_PASSWORD_FILE=""
# Compose requires exactly true or false; true enables verified PostgreSQL TLS.
DATABASE_SSL=""
DATABASE_SSL_REJECT_UNAUTHORIZED="true"
DATABASE_POOL_SIZE="10"

# Docker Compose. Compose builds the app and migrator URLs itself (roles eltnoy_app and
# eltnoy_migrator, no password in any URL) and mounts passwords from files in ELTNOY_SECRETS_DIR:
# postgres_superuser_password (root:root 0400), eltnoy_app_password (root:10001 0440) and
# eltnoy_migrator_password (root:10002 0440). Keep that directory OUTSIDE the repository, for example
# /etc/eltnoy/secrets; for local development use ./.local-dev/secrets (Git- and Docker-ignored).
# No database password belongs in this file.
ELTNOY_SECRETS_DIR="/etc/eltnoy/secrets"
POSTGRES_DB="eltnoy"
POSTGRES_USER="eltnoy"
POSTGRES_TLS_DIR="/etc/eltnoy/postgres-tls"
POSTGRES_CA_FILE="/etc/eltnoy/postgres-tls/ca.crt"

PORT="4000"
NODE_ENV="development"
APP_ORIGIN="http://localhost:3000"
APP_HOSTNAME=""
TLS_CERT_DIR="/etc/eltnoy/tls"

# Institution document uploads remain hard-disabled in Milestone 2, even if
# these file policies are configured. Supported detected content types are
# PDF, JPEG, and PNG; browser MIME values are not trusted.
INSTITUTION_SUBMISSION_CAPABILITY_TTL_SECONDS="1800"
INSTITUTION_DOCUMENT_STORAGE_DIR=""
INSTITUTION_DOCUMENT_MAX_BYTES=""
INSTITUTION_DOCUMENT_ALLOWED_MIME_TYPES=""
INSTITUTION_DOCUMENT_CARDINALITY=""
INSTITUTION_DOCUMENT_MAX_DOCUMENTS_PER_CATEGORY=""
# Replacement is disabled unless explicitly enabled after the client confirms rules.
INSTITUTION_DOCUMENT_REPLACEMENT_ENABLED="false"
INSTITUTION_DOCUMENT_MAX_VERSIONS_PER_DOCUMENT=""
# Do not set decision codes until the client confirms decision vocabulary and rules.
INSTITUTION_DOCUMENT_REVIEW_DECISION_CODES=""

# --- P1-B surface isolation (validated at API startup; invalid or missing values stop startup) ---
# Mode: production | staging | development. Required; there is no default.
ELTNOY_SURFACE_MODE=
# Listener(s) this API process runs (P1-D.2): public (4000) or admin (4001). Required; no default.
# docker-compose.yml sets it per service (api_public / api_admin). public,admin is accepted only with
# ELTNOY_SURFACE_MODE=development (for example `npm run dev:api`). ONLINE_EXAM_RECOVERY_SINCE is
# rejected on an instance without the public listener: recovery is owned by the public instance.
ELTNOY_API_LISTENERS=
# Trusted reverse-proxy peers, separately per listener (comma-separated). Both are required in every
# mode. Each entry must be ONE proxy address (IPv4 /32 or IPv6 /128); subnets, duplicates, an address
# in both lists, IPv4-mapped IPv6, link-local, multicast/reserved, unspecified and (outside
# development) loopback addresses are rejected. Addresses are not judged by their last octet: P1-F
# must verify each one is the proxy container's own address (not its gateway, network or broadcast
# address). Production values are established in P1-D/P1-F; do not guess them.
# ELTNOY_TRUSTED_PROXY_CIDRS is no longer supported and is rejected if set.
# Development: use two DISTINCT loopback addresses, e.g. public 127.0.0.1 and Admin ::1. Local
# development: `npm run dev:api:local` sets exactly those and the four exact *.127.0.0.1.nip.io surface
# hostnames, and binds both listeners to loopback only. The Vite proxy forwards X-ELTNOY-Original-Host
# and sends Admin traffic to [::1]:4001. Open Admin at http://admin.127.0.0.1.nip.io:3000/login/official.
ELTNOY_PUBLIC_PROXY_CIDRS=
ELTNOY_ADMIN_PROXY_CIDRS=
# Admin listener port (public listener uses PORT, default 4000). Default 4001; must differ from PORT.
# Note: since P1-B, APP_ORIGIN, APP_HOSTNAME and TLS_CERT_DIR (above) are not used: each surface's
# exact Origin is derived from its hostname, and since P1-D.2 docker-compose.yml no longer reads them.
ADMIN_PORT=4001
# Surface hostnames. Production: leave unset (pinned to eltnoy.com, exam./institution.eltnoy.com and the
# private Admin hostname admin.eltnoy.in).
# Staging and development: all four are required, lower-case, without ports, and must not be the
# production hostnames.
ELTNOY_MARKETING_HOSTNAME=
ELTNOY_EXAM_HOSTNAME=
ELTNOY_INSTITUTION_HOSTNAME=
ELTNOY_ADMIN_HOSTNAME=
# Development only (rejected in production and staging): expected Origin scheme (http|https) and port.
ELTNOY_DEV_ORIGIN_SCHEME=
ELTNOY_DEV_ORIGIN_PORT=

# --- P1-D.2 Docker Compose topology (docker-compose.yml; statically tested, not runtime-validated) ---
# Under Compose, the proxy lists above are derived from NGINX_PUBLIC_APP_ADDRESS (public list) and
# NGINX_ADMIN_APP_ADDRESS (Admin list); set ELTNOY_*_PROXY_CIDRS directly only outside Compose.
# Addresses and subnets are NOT preconfigured: choose them in P1-D (private, non-overlapping, no
# gateway/network/broadcast address) and verify the observed proxy source addresses in P1-F.
PUBLIC_APP_SUBNET=
ADMIN_APP_SUBNET=
NGINX_PUBLIC_APP_ADDRESS=
NGINX_ADMIN_APP_ADDRESS=
API_PUBLIC_APP_ADDRESS=
API_ADMIN_APP_ADDRESS=
# Host interface addresses that Nginx publishes on (M-2; validated by server/validateDeploymentConfig.ts
# on the host preflight and in each API container; literal IPv4 only, no DNS, never inferred):
# - PUBLIC_BIND_MODE: required. Use private-eni for VPC hosts. Set to direct-vps only when this host
#   has a directly assigned public IPv4 and the host firewall is active and verified.
# - PUBLIC_BIND_ADDRESS: the private (RFC 1918) ENI by default; with direct-vps, the public IPv4
#   assigned to the VPS interface (80/443). Never use a wildcard or infer the address from DNS.
# - WIREGUARD_INTERFACE_ADDRESS: the address assigned to the host's wg0 interface, copied by the
#   operator from the WireGuard configuration (private RFC 1918 or 100.64.0.0/10 tunnel range).
# - ADMIN_BIND_ADDRESS: where the Admin Nginx publishes 443; must EQUAL WIREGUARD_INTERFACE_ADDRESS.
# Wildcard (0.0.0.0, ::), loopback, link-local, multicast, public and IPv6 values are rejected; the
# Admin and public bind addresses must differ. If wg0 does not hold the address, the bind fails.
PUBLIC_BIND_ADDRESS=
PUBLIC_BIND_MODE=
ADMIN_BIND_ADDRESS=
WIREGUARD_INTERFACE_ADDRESS=
# Separate certificate directories (never the same directory). Public: SANs exactly eltnoy.com,
# exam.eltnoy.com, institution.eltnoy.com. Admin: SAN admin.eltnoy.in only (private/internal CA or
# another approved private-hostname approach). fullchain.pem + privkey.pem, owned 101:101, key 0600.
PUBLIC_TLS_CERT_DIR=
ADMIN_TLS_CERT_DIR=
# Images. ELTNOY_API_IMAGE (M-1) must be a local-only tag of the form localhost/eltnoy-api:<tag>: it
# is always built from this repository by api_public (pull_policy: build) and reused by api_admin
# (pull_policy: never); registry, Docker Hub, digest and untagged references are rejected.
# NGINX_IMAGE and POSTGRES_IMAGE must be digest-pinned references (name@sha256:...)
# verified by the operator: nginx-unprivileged with Nginx 1.19.4 or later, PostgreSQL 17. No digest
# is preconfigured — verifying them is a deployment blocker.
ELTNOY_API_IMAGE=
NGINX_IMAGE=
POSTGRES_IMAGE=

# P1-D.3 deployment wrapper: run every host preflight and deployment Compose operation through
#   scripts/eltnoy-deploy.sh --deployment-env-file /absolute/path/.env.production <operation>
# (runbook §14.9). The production env file must be mode 0600/0640, use plain KEY=VALUE lines
# (optionally fully quoted), contain no $ / ${...} interpolation, spaces or COMPOSE_*/DOCKER_* keys
# in deployment settings, and none of these settings may also be set in the operator's shell.

# AUTH C1.3-B: SMS abuse-protection limits and the Student registration claim lifetime
# (runbook §3.8). Values are PENDING OWNER APPROVAL and there are NO defaults: leave them empty.
# - Empty: every SMS stays refused (SMS protection closed); empty claim lifetime keeps Student
#   registration closed.
# - The eight AUTH_SMS_* settings are all-or-nothing: the preflight accepts all empty or all eight
#   valid (positive whole numbers; the unverified daily cap must not exceed the daily total) and
#   rejects anything in between. The claim lifetime is validated on its own (at most 900).
# - Forwarded to api_public only. Limits alone never enable SMS; a Twilio adapter and the OTP key must
#   also be configured. Empty limits keep delivery closed even if credentials are present.
AUTH_SMS_UNVERIFIED_DESTINATION_WINDOW_SECONDS=
AUTH_SMS_UNVERIFIED_DESTINATION_MAX_SENDS=
AUTH_SMS_VERIFIED_DESTINATION_WINDOW_SECONDS=
AUTH_SMS_VERIFIED_DESTINATION_MAX_SENDS=
AUTH_SMS_ACCOUNT_DESTINATION_WINDOW_SECONDS=
AUTH_SMS_ACCOUNT_DESTINATION_MAX_SENDS=
AUTH_SMS_DAILY_MAX_SENDS=
AUTH_SMS_DAILY_MAX_UNVERIFIED_SENDS=
AUTH_STUDENT_REGISTRATION_CLAIM_TTL_SECONDS=

# AUTH C1.4-B-2: email abuse-protection limits (runbook §3.10). Values are PENDING OWNER APPROVAL and
# there are NO defaults: leave them empty. Empty keeps every email refused (Institute registration and
# sign-in stay closed). The six are all-or-nothing: the preflight accepts all empty or all six valid
# (positive whole numbers; the unverified daily cap must not exceed the email daily total) and rejects
# anything in between. Forwarded to api_public only. Limits alone never enable email; the Resend
# adapter, sender verification, OTP key and deployment secret wiring are also required.
AUTH_EMAIL_UNVERIFIED_DESTINATION_WINDOW_SECONDS=
AUTH_EMAIL_UNVERIFIED_DESTINATION_MAX_SENDS=
AUTH_EMAIL_ACCOUNT_DESTINATION_WINDOW_SECONDS=
AUTH_EMAIL_ACCOUNT_DESTINATION_MAX_SENDS=
AUTH_EMAIL_DAILY_MAX_SENDS=
AUTH_EMAIL_DAILY_MAX_UNVERIFIED_SENDS=

# Optional delivery adapters for Student and Institute verification. Use `twilio-verify` for
# provider-managed OTPs (including Twilio's trial) or `twilio` for the legacy Messaging integration.
# Leave provider names unset until account setup, protected secret files and abuse limits are ready.
# *_FILE entries are host file paths mounted read-only into api_public; never put tokens in this file.
# Store them as root:10001 mode 0440. The OTP HMAC key file must contain at least 32 random bytes.
AUTH_SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_AUTH_TOKEN_FILE=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_API_KEY_SID=
TWILIO_VERIFY_API_KEY_SECRET_FILE=
AUTH_EMAIL_PROVIDER=
RESEND_FROM_EMAIL=
RESEND_API_KEY_FILE=
AUTH_OTP_HMAC_KEY_FILE=
